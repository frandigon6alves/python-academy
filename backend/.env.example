# All settings are optional; these are the defaults.
# The database: a local SQLite file unless DATABASE_URL (or ACADEMY_DATABASE_URL) is set.
# PostgreSQL URLs such as postgresql://user:pass@host/db?sslmode=require are accepted as-is.
# DATABASE_URL=sqlite:///./data/academy.sqlite
# ACADEMY_SESSION_DAYS=30
# Set to true when serving over HTTPS.
# ACADEMY_COOKIE_SECURE=false
# ACADEMY_LOGIN_MAX_ATTEMPTS=5
# ACADEMY_LOGIN_WINDOW_SECONDS=300
